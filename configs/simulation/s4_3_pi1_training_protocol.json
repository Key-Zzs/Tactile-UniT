{
  "schema": "tactile3d-unit.s4-3-pi1-training-protocol.v1",
  "stage": "S4.3-PI1B-PI1C",
  "task": "pinch_tongs",
  "regime": "rand_obj",
  "models": {
    "B0": "frozen local PI0 official 30000-step seed42 checkpoint",
    "B1": "CONTACT_STATE_TOKENS initialized from exact pi05_base",
    "B2": "CONTACT_STATE_TOKENS_PHYSICAL_AUX initialized independently from exact pi05_base"
  },
  "common": {
    "seed": 42,
    "steps": 30000,
    "global_batch_size": 32,
    "num_workers": 4,
    "initialization": "pi05_base only",
    "dataset": "same official 100-episode pinch_tongs dataset; B1/B2 reference the frozen tactile sidecar",
    "optimizer": {
      "name": "AdamW",
      "b1": 0.9,
      "b2": 0.95,
      "eps": 1e-08,
      "weight_decay": 1e-10,
      "clip_gradient_norm": 1.0
    },
    "lr_schedule": {
      "name": "cosine_decay_with_warmup",
      "warmup_steps": 10000,
      "peak_lr": 0.00005,
      "decay_steps": 1000000,
      "decay_lr": 0.00005
    },
    "lora": {
      "paligemma_variant": "gemma_2b_lora",
      "action_expert_variant": "gemma_300m_lora",
      "official_freeze_filter": true
    },
    "action_horizon": 30,
    "action_dim": 32,
    "max_token_len": 250,
    "ema_decay": null,
    "save_steps": [10000, 20000, 30000],
    "checkpoint_selection": "final only; no rollout-based selection",
    "sweeps": false
  },
  "B1": {
    "mode": "CONTACT_STATE_TOKENS",
    "lambda_phys": 0.0,
    "extra_trainable_parameters": ["contact_adapter"]
  },
  "B2": {
    "mode": "CONTACT_STATE_TOKENS_PHYSICAL_AUX",
    "lambda_phys": "frozen result of the preregistered four-batch calibration",
    "extra_trainable_parameters": ["contact_adapter", "physical_auxiliary"]
  },
  "lambda_calibration": {
    "timing": "after B1 final freeze and before B2 launch",
    "data": "first four batches of the seed42 deterministically shuffled training iterator",
    "batch_size": 32,
    "model_state": "B2 initialization from pi05_base before optimizer updates",
    "formula": "0.1 * mean(L_official_pi05) / mean(L_phys)",
    "clamp": [0.001, 0.1],
    "rollout_performance_used": false,
    "recalculation_during_training": false
  },
  "order": ["PI1B stable launch", "mandatory pause", "PI1B completion audit", "PI1C calibration", "PI1C stable launch", "mandatory pause"]
}
